<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcs_backend_theme.AppIcon">
        <span t-attf-class="cbt-app-icon cbt-app-icon--{{ this.props.size }}" aria-hidden="true">
            <t t-set="fa" t-value="this.fontIcon"/>
            <span t-if="fa" class="cbt-app-icon__font" t-attf-style="color: {{ fa.color }}; background: {{ fa.background }};">
                <i t-if="fa.name" class="oi" t-att-data-icon="fa.name"/>
                <span t-else="" class="cbt-app-icon__initial" t-out="this.initials"/>
            </span>
            <img t-else="" t-att-src="this.imageSrc" alt="" loading="lazy" draggable="false"/>
        </span>
    </t>
</templates>
