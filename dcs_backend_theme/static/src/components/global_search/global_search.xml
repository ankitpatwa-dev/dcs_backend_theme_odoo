<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcs_backend_theme.GlobalSearch">
        <div class="cbt-overlay cbt-search-overlay" t-on-click.self="close">
            <div class="cbt-search" t-ref="root" role="dialog" aria-modal="true" t-att-aria-label="labels.dialog">
                <div class="cbt-search__field">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <input type="text" class="cbt-search__input" data-autofocus="1"
                           role="combobox" aria-autocomplete="list" aria-expanded="true"
                           t-att-aria-controls="listId"
                           t-att-aria-activedescendant="items.length ? optionId(state.activeIndex) : false"
                           t-att-placeholder="labels.placeholder" t-att-aria-label="labels.placeholder"
                           autocomplete="off" spellcheck="false"
                           t-model="state.query" t-on-input="onInput" t-on-keydown="onKeydown"/>
                    <span class="cbt-kbd">Esc</span>
                </div>

                <div class="cbt-search__results" t-att-id="listId" role="listbox" t-att-aria-label="labels.dialog">
                    <t t-foreach="groups" t-as="group" t-key="group.id">
                        <div class="cbt-search__group" role="group" t-att-aria-label="group.title">
                            <div class="cbt-search__group-title">
                                <span t-esc="group.title"/>
                                <button t-if="group.id === 'history'" type="button" class="btn btn-link btn-sm p-0" t-on-click="clearHistory" t-esc="labels.clear"/>
                            </div>
                            <t t-foreach="group.items" t-as="item" t-key="item.key">
                                <div class="cbt-search__option" role="option"
                                     t-att-id="optionId(item.index)"
                                     t-att-aria-selected="state.activeIndex === item.index ? 'true' : 'false'"
                                     t-att-class="{ 'cbt-search__option--active': state.activeIndex === item.index }"
                                     t-on-mousemove="() => this.hover(item.index)"
                                     t-on-click="() => this.select(item)">
                                    <span class="cbt-search__option-icon">
                                        <AppIcon t-if="item.app" app="item.app" size="'sm'"/>
                                        <i t-elif="item.kind === 'history'" class="fa fa-history" aria-hidden="true"/>
                                        <i t-elif="item.kind === 'palette'" class="fa fa-terminal" aria-hidden="true"/>
                                        <i t-else="" class="fa fa-bookmark-o" aria-hidden="true"/>
                                    </span>
                                    <span class="cbt-search__option-label">
                                        <t t-if="item.kind === 'palette'"><t t-esc="labels.palette"/> “<b t-esc="item.label"/>”</t>
                                        <t t-else="" t-esc="item.label"/>
                                    </span>
                                    <span class="cbt-search__option-meta" t-esc="typeLabel(item)"/>
                                    <i class="fa fa-level-down cbt-search__option-enter" aria-hidden="true"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <p class="cbt-search__empty" t-if="query and items.length lte 1" t-esc="labels.empty"/>
                </div>

                <div class="cbt-search__footer" aria-hidden="true">
                    <span><span class="cbt-kbd"><i class="oi oi-arrow-up"/></span><span class="cbt-kbd"><i class="oi oi-arrow-down"/></span> <t t-esc="labels.navigate"/></span>
                    <span><span class="cbt-kbd">Enter</span> <t t-esc="labels.open"/></span>
                    <span><span class="cbt-kbd">Esc</span> <t t-esc="labels.close"/></span>
                </div>
            </div>
        </div>
    </t>
</templates>
