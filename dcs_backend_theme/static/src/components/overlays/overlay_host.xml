<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcs_backend_theme.OverlayHostGate">
        <OverlayHostImpl t-if="env.cbtInWebClient"/>
    </t>

    <t t-name="dcs_backend_theme.OverlayHost">
        <div class="cbt-overlay-root" t-if="themeUi.panel">
            <AppDrawer t-if="themeUi.panel === 'drawer'"/>
            <GlobalSearch t-elif="themeUi.panel === 'search'"/>
            <BookmarksPanel t-elif="themeUi.panel === 'bookmarks'"/>
            <ThemePanel t-elif="themeUi.panel === 'settings'"/>
        </div>
    </t>
</templates>
