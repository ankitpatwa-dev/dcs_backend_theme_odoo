<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcs_backend_theme.ThemePanel">
        <div class="cbt-overlay cbt-sheet-overlay cbt-sheet-overlay--settings" t-on-click.self="close">
            <aside class="cbt-sheet cbt-sheet--settings" t-ref="root" role="dialog" aria-modal="true" t-att-aria-label="labels.title">
                <header class="cbt-sheet__header">
                    <h2 class="cbt-sheet__title"><i class="fa fa-sliders me-2" aria-hidden="true"/><t t-esc="labels.title"/></h2>
                    <button type="button" class="cbt-icon-btn" data-autofocus="1" t-att-aria-label="labels.close" t-att-title="labels.close" t-on-click="close">
                        <i class="oi oi-close" aria-hidden="true"/>
                    </button>
                </header>
                <div class="cbt-sheet__body">
                    <ThemeSettings compact="true"/>
                </div>
                <footer class="cbt-sheet__footer" t-if="isSystem">
                    <button type="button" class="btn btn-secondary w-100" t-on-click="openFullPage">
                        <i class="fa fa-paint-brush me-2" aria-hidden="true"/><t t-esc="labels.more"/>
                    </button>
                </footer>
            </aside>
        </div>
    </t>
</templates>
